{
  "name": "andrea-agostini-website",
  "version": "1.29.0",
  "private": true,
  "scripts": {
    "build": "yarn lint:fix && yarn build:compile && yarn build:sitemap",
    "build-storybook": "storybook build",
    "build:compile": "next build",
    "build:config": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:sitemap": "NODE_OPTIONS='--no-deprecation' next-sitemap --config next-sitemap.config.mjs",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --build-script-name build-storybook --exit-zero-on-changes",
    "dev": "NODE_OPTIONS='--no-deprecation' next dev --webpack",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "lint": "eslint --ext ts,tsx . --quiet",
    "lint:fix": "eslint --fix --ext ts,tsx .",
    "postbuild": "NODE_OPTIONS='--no-deprecation' next-sitemap --config next-sitemap.config.mjs",
    "prettier:fix": "prettier --write .",
    "reset": "npx rimraf .yarn yarn.lock node_modules && touch yarn.lock && yarn install",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:update": "jest --updateSnapshot",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "contentful": "11.12.10",
    "dotenv": "18.0.5",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-seo": "6.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "styled-components": "6.5.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.4.0",
    "@eslint/js": "10.0.1",
    "@jest/globals": "^30.5.2",
    "@jest/types": "^30.5.1",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-onboarding": "10.6.1",
    "@storybook/nextjs": "10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/identity-obj-proxy": "^3.0.2",
    "@types/jest": "^30.0.0",
    "@types/styled-components": "5.1.36",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "chromatic": "18.10.1",
    "contentful-management": "^12.19.0",
    "eslint": "10.11.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "8.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-styled-components": "7.4.0",
    "lint-staged": "17.6.0",
    "next-sitemap": "^4.2.3",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "storybook-dark-mode": "^5.0.0",
    "ts-jest": "29.4.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.9.7",
    "typescript-eslint": "8.71.0",
    "wait-on": "^9.5.1"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      [
        "eslint",
        "prettier --write"
      ],
      "git add"
    ],
    "**/*.{md,mdx,json}": [
      [
        "eslint",
        "prettier --write"
      ],
      "git add"
    ]
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "yarn@4.13.0"
}
