  text-decoration: none;
  transition: color 0.2s ease-in-out;
}

.c4:focus-visible {
  outline: 2px solid var(--color-highlight);
  outline-offset: 2px;
}

.c12 {
  position: relative;
}

.c13 {
  align-items: center;
  background: none;
  border: 1px solid color-mix(in srgb, var(--color-headline) 20%, transparent);
  border-radius: 4px;
  color: var(--color-headline);
  cursor: pointer;
  display: flex;
  justify-content: center;
  min-height: 44px;
  min-width: 44px;
  padding: 0.25rem 0.625rem;
  transition: all 0.2s ease;
}

.c13 svg {
  height: 18px;
  width: 18px;
}

.c13:focus-visible {
  outline: 2px solid var(--color-highlight);
  outline-offset: 3px;
}

.c14 {
  align-items: center;
  display: none;
  justify-content: center;
}

html[data-theme="light"] .c14[data-icon="light"],
html[data-theme="dark"] .c14[data-icon="dark"],
html:not([data-theme]) .c14[data-icon="system"] {
  display: flex;
}

.c0 {
  background: var(--color-background);
  border-bottom: 1px solid transparent;
