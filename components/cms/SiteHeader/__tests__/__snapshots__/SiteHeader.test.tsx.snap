exports[`SiteHeader renders correctly with no nav links 1`] = `
.c1 {
  display: grid;
  min-height: auto;
  position: relative;
  width: 100%;
  column-gap: 16px;
  grid-template-columns: 1fr min(1440px, 100% - 32px) 1fr;
}

.c1 >* {
  grid-column: 2/auto;
}

.c2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c7 {
  display: flex;
  gap: 2rem;
  align-items: center;
}

.c9 {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.c4 {
  color: var(--color-highlight);
  font-size: 1rem;
  line-height: 1;
  text-decoration: none;
  transition: color 0.2s ease-in-out;
}

.c4:focus-visible {
  outline: 2px solid var(--color-highlight);
  outline-offset: 2px;
}

.c11 {
  position: relative;
}

.c12 {
  align-items: center;
  background: none;
  border: 1px solid color-mix(in srgb, var(--color-headline) 20%, transparent);
  border-radius: 4px;
  color: var(--color-headline);
  cursor: pointer;
  display: flex;
  justify-content: center;
  min-height: 44px;
  min-width: 44px;
  padding: 0.25rem 0.625rem;
  transition: all 0.2s ease;
}

.c12 svg {
  height: 18px;
  width: 18px;
}

.c12:focus-visible {
  outline: 2px solid var(--color-highlight);
  outline-offset: 3px;
}

.c13 {
  align-items: center;
  display: none;
  justify-content: center;
}

html[data-theme="light"] .c13[data-icon="light"],
html[data-theme="dark"] .c13[data-icon="dark"],
html:not([data-theme]) .c13[data-icon="system"] {
  display: flex;
}

.c0 {
  background: var(--color-background);
  border-bottom: 1px solid transparent;
  box-sizing: border-box;
  box-shadow: none;
  height: var(--site-header-height);
  left: 0;
  padding: 0.75rem 0;
  position: fixed;
  right: 0;
  top: 0;
  transition: border-color 0.3s ease,box-shadow 0.3s ease;
  width: 100%;
  z-index: 100;
}

.c5 {
  align-items: center;
  cursor: pointer;
  display: inline-flex;
  text-decoration: none;
}

.c6 {
  display: block;
  height: 2.75rem;
  width: auto;
}

.c8 {
  align-items: center;
  display: none;
  gap: 2rem;
}

.c10 {
  align-items: center;
  background: none;
  border: 1px solid color-mix(in srgb, var(--color-headline) 20%, transparent);
  border-radius: 4px;
  color: var(--color-headline);
  cursor: pointer;
  display: flex;
  font-size: 0.75rem;
  font-weight: 700;
  justify-content: center;
  letter-spacing: 0.08em;
  min-height: 44px;
  min-width: 44px;
  padding: 0.25rem 0.625rem;
  text-transform: uppercase;
  transition: all 0.2s ease;
}

.c10:focus-visible {
  outline: 2px solid var(--color-highlight);
  outline-offset: 3px;
}

@media (min-width: 600px) {
  .c1 {
    column-gap: calc(24px);
    grid-template-columns: 1fr min(1440px, 100% - 48px) 1fr;
  }
}

@media (min-width: 900px) {
  .c1 {
    column-gap: calc(36px);
    grid-template-columns: 1fr min(1440px, 100% - 72px) 1fr;
  }
}

@media (min-width: 1200px) {
  .c1 {
    column-gap: calc(81px);
    grid-template-columns: 1fr min(1440px, 100% - 162px) 1fr;
  }
}

@media (min-width: 1536px) {
  .c1 {
    column-gap: calc(121.5px);
    grid-template-columns: 1fr min(1440px, 100% - 243px) 1fr;
  }
}

@media (min-width: 600px) {
  .c1 >* {
    grid-column: 2/auto;
  }
}

@media (min-width: 1200px) {
  .c1 >* {
    grid-column: 2/auto;
  }
}

@media (min-width: 1536px) {
  .c1 >* {
    grid-column: 2/auto;
  }
}

@media (hover: hover) {
  .c4:hover {
    color: var(--color-tertiary);
  }
}

@media (hover: hover) {
  .c12:hover {
    background: color-mix(         in srgb,         var(--color-headline) 5%,         transparent       );
    border-color: color-mix(         in srgb,         var(--color-headline) 40%,         transparent       );
  }
}

@media (max-width: 899.99px) {
  .c12 {
    border-color: color-mix(       in srgb,       var(--color-headline) 22%,       transparent     );
    border-radius: 6px;
    height: 36px;
    min-height: 36px;
    min-width: 36px;
    padding: 0;
    width: 36px;
  }

  .c12 svg {
    height: 16px;
    width: 16px;
  }

  .c12:focus-visible {
    border-color: var(--color-highlight);
    color: var(--color-highlight);
  }
}

@media (max-width: 899.99px) {
  .c0 {
    box-shadow: none;
    padding: 0;
  }
}

@media (max-width: 899.99px) {
  .c3 {
    height: var(--site-header-height);
  }
}

@media (max-width: 899.99px) {
  .c6 {
    height: 2.25rem;
  }
}

@media (min-width: 900px) {
  .c8 {
    display: flex;
  }
}

@media (hover: hover) {
  .c10:hover {
    background: color-mix(         in srgb,         var(--color-headline) 5%,         transparent       );
    border-color: color-mix(         in srgb,         var(--color-headline) 40%,         transparent       );
  }
}

@media (max-width: 899.99px) {
  .c10 {
    border-color: color-mix(       in srgb,       var(--color-headline) 22%,       transparent     );
    border-radius: 6px;
    height: 36px;
    min-height: 36px;
    min-width: 36px;
    padding: 0;
    width: 36px;
  }

  .c10:focus-visible {
    border-color: var(--color-highlight);
    color: var(--color-highlight);
  }
}

